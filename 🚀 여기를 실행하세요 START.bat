@echo off
chcp 65001 >nul
title iParking 자동화 시스템

REM ════════════════════════════════════════════════════════════
REM  🚗 iParking 자동화 시스템 - 원클릭 실행
REM ════════════════════════════════════════════════════════════

echo.
echo ═══════════════════════════════════════════════════════════
echo  🚗 iParking 자동화 시스템 시작
echo ═══════════════════════════════════════════════════════════
echo.

REM 스크립트 폴더로 이동
cd /d "%~dp0"

REM ────────────────────────────────────────────────────────────
REM  [1단계] 가상환경 활성화
REM ────────────────────────────────────────────────────────────
echo [1/3] 가상환경 활성화 중...

call venv\Scripts\activate.bat
if errorlevel 1 (
    echo.
    echo ❌ 오류: 가상환경을 찾을 수 없습니다!
    echo.
    echo 💡 해결방법:
    echo    1. 빠른_설치.bat 실행
    echo    2. 설치 완료 후 다시 이 파일 실행
    echo.
    pause
    exit /b 1
)

echo      ✅ 가상환경 활성화 완료
echo.

REM ────────────────────────────────────────────────────────────
REM  [2단계] 대시보드 실행 (백그라운드)
REM ────────────────────────────────────────────────────────────
echo [2/3] 📊 대시보드 실행 중...
echo      (새 창에서 백그라운드로 실행됩니다)
echo.

start "iParking Dashboard" cmd /k "cd /d %~dp0 && call venv\Scripts\activate.bat && cd iparking-bot && streamlit run dashboard.py"

timeout /t 3 /nobreak >nul

echo      ✅ 대시보드 실행 완료
echo         주소: http://localhost:8501
echo.

REM ────────────────────────────────────────────────────────────
REM  [3단계] 주차 프로그램 실행 (메인 창)
REM ────────────────────────────────────────────────────────────
echo [3/3] 🤖 주차 프로그램 시작...
echo.
echo ═══════════════════════════════════════════════════════════
echo.

cd /d "%~dp0iparking-bot"

python bot_Simple_logic.py

REM ────────────────────────────────────────────────────────────
REM  종료 안내
REM ────────────────────────────────────────────────────────────
echo.
echo ═══════════════════════════════════════════════════════════
echo  ✅ 주차 프로그램 종료
echo ═══════════════════════════════════════════════════════════
echo.
echo  💡 대시보드는 계속 실행 중입니다
echo     닫으려면 "iParking Dashboard" 창을 닫으세요
echo.
pause
